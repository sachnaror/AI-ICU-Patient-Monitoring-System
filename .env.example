APP_ENV=local
HOST=127.0.0.1
PORT=8000

# ICU/demo configuration
BED_ID=ICU-12
VIDEO_SOURCE=data/sample_videos/patient_fall_demo.mp4
USE_WEBCAM=false

# Runtime configuration
ENABLE_GPU=false
FALL_ALERT_COOLDOWN_SECONDS=8

# Oxygen alert thresholds
LOW_SPO2_THRESHOLD=92
CRITICAL_SPO2_THRESHOLD=88
APP_ENV=local
HOST=127.0.0.1
PORT=8000

# ICU/demo configuration
BED_ID=ICU-12
VIDEO_SOURCE=data/sample_videos/patient_fall_demo.mp4
USE_WEBCAM=false

# Runtime configuration. Keep these false on local Mac CPU demo.
ENABLE_GPU=false
ENABLE_HOLOSCAN=false
ENABLE_DEEPSTREAM=false
ENABLE_TRITON=false
TENSORRT_ENGINE_PATH=app/ai_models/patient_detection/model.engine
TRITON_URL=localhost:8001
TRITON_MODEL_NAME=icu_patient_detector
FALL_ALERT_COOLDOWN_SECONDS=8

# Oxygen alert thresholds
LOW_SPO2_THRESHOLD=92
CRITICAL_SPO2_THRESHOLD=88
